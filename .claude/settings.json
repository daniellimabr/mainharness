{
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "ENABLE_COMMIT_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(hx *)",
      "PowerShell(hx *)",
      "Bash(npm run *)",
      "PowerShell(npm run *)",
      "Bash(git status*)",
      "PowerShell(git status*)",
      "Bash(git diff*)",
      "PowerShell(git diff*)",
      "Bash(git log*)",
      "PowerShell(git log*)",
      "Bash(git show*)",
      "PowerShell(git show*)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(ls*)",
      "Bash(wc *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-ChildItem*)"
    ]
  },
  "enabledPlugins": {
    "main-harness@harness-stable": true,
    "ponytail@ponytail": true,
    "security-guidance@claude-plugins-official": true
  },
  "autoCompactWindow": 250000
}
