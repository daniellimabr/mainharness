@@ -193,8 +193,47 @@ async function start(args: string[], deps: Deps): Promise<number> {
   return r.code === 0 ? 0 : 1;
 }
 
+/** One line per alias; url without credentials, token never read. */
+function list(): number {
+  const all: unknown = loadConfig().workers;
+  if (all === null || typeof all !== "object" || Array.isArray(all)) {
+    console.error("Configuração de workers inválida: esperado um objeto de apelidos.");
+    return 1;
+  }
+  const aliases = Object.keys(all).sort((a, b) => a.localeCompare(b));
+  if (!aliases.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const alias of aliases) {
+    const w = (all as Record<string, Partial<Worker> | null>)[alias];
+    let u: URL | undefined;
+    try {
+      if (typeof w?.url === "string") u = new URL(w.url);
+    } catch {
+      /* mal configurado */
+    }
+    if (!u || typeof w?.model !== "string") {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    const url = `${u.protocol}//${u.host}${u.pathname === "/" ? "" : u.pathname}${u.search}`;
+    const p = w.price;
+    const price = !p
+      ? "sem preço"
+      : p.input === 0 && p.output === 0
+        ? "grátis"
+        : `US$ ${p.input}/${p.output} por milhão`;
+    console.log(`${alias}  ${w.model}  ${url}  ${price}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
