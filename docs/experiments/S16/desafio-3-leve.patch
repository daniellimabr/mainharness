+
+describe("hx worker list", () => {
+  it("lists aliases sorted, without credentials or token", async () => {
+    fs.writeFileSync(
+      path.join(env.home, "config.json"),
+      JSON.stringify({
+        workers: {
+          zeta: {
+            url: "http://u:p@h:1/x",
+            model: "m/z",
+            token: "sk-zz",
+            price: { input: 0, output: 0 },
+          },
+          alfa: { url: "http://h:2", model: "m/a", token: "sk-aa" },
+        },
+      }),
+    );
+    const log = vi.spyOn(console, "log").mockImplementation(() => {});
+    expect(await run(["list"])).toBe(0);
+    const lines = log.mock.calls.map((c) => String(c[0]));
+    expect(lines[0]).toMatch(/^alfa {2}m\/a {2}http:\/\/h:2 {2}sem preço$/);
+    expect(lines[1]).toMatch(/^zeta {2}m\/z {2}http:\/\/h:1\/x {2}grátis$/);
+    expect(lines.join("\n")).not.toMatch(/sk-|u:p/);
+  });
+
+  it("empty, malformed entry and invalid workers", async () => {
+    const cfg = (workers: unknown) =>
+      fs.writeFileSync(path.join(env.home, "config.json"), JSON.stringify({ workers }));
+    const log = vi.spyOn(console, "log").mockImplementation(() => {});
+    const err = vi.spyOn(console, "error").mockImplementation(() => {});
+    cfg({});
+    expect(await run(["list"])).toBe(0);
+    expect(log).toHaveBeenLastCalledWith("Nenhum trabalhador configurado.");
+    cfg({
+      b: { url: 1, model: "m", token: "sk-x" },
+      a: { url: "http://h", model: "m", price: { input: 1, output: 2 } },
+    });
+    expect(await run(["list"])).toBe(1);
+    expect(log.mock.calls.slice(-2).map((c) => c[0])).toEqual([
+      "a  m  http://h  US$ 1/2 por milhão",
+      "b  (mal configurado)",
+    ]);
+    log.mockClear();
+    cfg(["x"]);
+    expect(await run(["list"])).toBe(1);
+    expect(log).not.toHaveBeenCalled();
+    expect(err.mock.calls.join(" ")).toContain("workers");
+  });
+});
