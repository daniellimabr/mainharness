+/** Creates the lock atomically (complete file or nothing) with this PID; false if a live worker holds it. */
+function takeLock(sprint: string, tnn: string): boolean {
+  fs.mkdirSync(dir(), { recursive: true });
+  const tmp = `${lockFile()}.${process.pid}.${Math.random().toString(36).slice(2)}`;
+  fs.writeFileSync(tmp, JSON.stringify({ pid: process.pid, sprint, task: tnn }));
+  try {
+    for (let i = 0; i < 2; i++) {
+      try {
+        fs.linkSync(tmp, lockFile()); // EEXIST if the lock exists
+        return true;
+      } catch (e) {
+        if ((e as NodeJS.ErrnoException).code !== "EEXIST") throw e;
+        const lock = readLock();
+        if (alive(lock.pid)) {
+          console.error(
+            `Já há um trabalhador rodando (${lock.sprint}/${lock.task}, PID ${lock.pid}).`,
+          );
+          return false;
+        }
+        fs.rmSync(lockFile(), { force: true }); // dead, empty or invalid: stale
+      }
+    }
+    console.error("Não consegui pegar o lock do trabalhador.");
+    return false;
+  } finally {
+    fs.rmSync(tmp, { force: true });
+  }
+}
