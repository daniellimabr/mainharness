 }
 
+/** Dead worker with no report newer than its lock: writes a failure report and warns, once. */
+function reportDead(): void {
+  const { pid, sprint, task: tnn } = readLock();
+  if (!sprint || !tnn || alive(pid)) return;
+  const report = path.join(dir(), `${sprint}-${tnn}.md`);
+  try {
+    const since = fs.statSync(lockFile()).mtimeMs;
+    if (fs.existsSync(report) && fs.statSync(report).mtimeMs > since) return;
+    fs.writeFileSync(
+      report,
+      `# Trabalhador ${sprint}/${tnn}\n\nO trabalhador falhou: o processo (PID ${pid}) morreu sem gravar relatório.\n`,
+    );
+    const after = new Date(since + 1000); // strictly newer than the lock, so the next call stays quiet
+    fs.utimesSync(report, after, after);
+    console.error(`Trabalhador ${sprint}/${tnn} falhou: morreu sem relatório; ver ${report}.`);
+  } catch {
+    // lock vanished meanwhile: nothing to report
+  }
+}
