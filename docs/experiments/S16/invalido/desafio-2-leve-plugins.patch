 function readLock(): { pid?: number; sprint?: string; task?: string } {
   try {
-    return (JSON.parse(fs.readFileSync(lockFile(), "utf8")) as { pid?: number } | null) ?? {};
+    return (
+      (JSON.parse(fs.readFileSync(lockFile(), "utf8")) as ReturnType<typeof readLock> | null) ?? {}
