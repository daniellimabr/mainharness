@@ -193,8 +193,51 @@ async function start(args: string[], deps: Deps): Promise<number> {
   return r.code === 0 ? 0 : 1;
 }
 
+/** `<apelido>  <modelo>  <url sem credenciais>  <preço>`; never prints the token. */
+function line(alias: string, w: unknown): string | null {
+  const x = (w && typeof w === "object" ? w : {}) as Partial<Worker>;
+  if (typeof x.url !== "string" || typeof x.model !== "string") return null;
+  let url: string;
+  try {
+    const u = new URL(x.url);
+    u.username = "";
+    u.password = "";
+    url = u.toString().replace(/\/$/, "");
+  } catch {
+    return null;
+  }
+  const p = x.price;
+  const price = !p
+    ? "sem preço"
+    : p.input === 0 && p.output === 0
+      ? "grátis"
+      : `US$ ${p.input}/${p.output} por milhão`;
+  return `${alias}  ${x.model}  ${url}  ${price}`;
+}
+
+function list(): number {
+  const all: unknown = loadConfig().workers;
+  if (all === null || typeof all !== "object" || Array.isArray(all)) {
+    console.error("A configuração de workers é inválida: esperado um objeto de apelidos.");
+    return 1;
+  }
+  const aliases = Object.keys(all).sort();
+  if (!aliases.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const a of aliases) {
+    const l = line(a, (all as Record<string, unknown>)[a]);
+    if (!l) code = 1;
+    console.log(l ?? `${a}  (mal configurado)`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
