+/** Dead worker with no report newer than its lock: writes a failure report and warns (once: the report is then newer). */
+function reapDead(): void {
+  const { pid, sprint, task: tnn } = readLock();
+  if (typeof pid !== "number" || alive(pid)) return;
+  if (typeof sprint !== "string" || typeof tnn !== "string") return;
+  if (!/^[\w-]+$/.test(sprint) || !/^[\w-]+$/.test(tnn)) return;
+  const report = path.join(dir(), `${sprint}-${tnn}.md`);
+  try {
+    if (fs.statSync(report).mtimeMs >= fs.statSync(lockFile()).mtimeMs) return;
+  } catch {
+    // no report yet
+  }
+  fs.writeFileSync(
+    report,
+    `# Trabalhador ${sprint}/${tnn}\n\nO trabalhador falhou: o processo (PID ${pid}) morreu sem gravar o relatório.\n`,
+  );
+  console.error(`Trabalhador ${sprint}/${tnn} falhou: morreu sem relatório (PID ${pid}).`);
+}
+
 /** Creates the lock atomically (flag wx), holding this PID until the child's; a stale lock is replaced once. */
