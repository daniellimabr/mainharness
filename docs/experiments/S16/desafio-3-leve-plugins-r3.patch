--- a/cli/src/commands/worker.ts
+++ b/cli/src/commands/worker.ts
@@ -193,8 +193,53 @@ async function start(args: string[], deps: Deps): Promise<number> {
   return r.code === 0 ? 0 : 1;
 }
 
+/** URL without credentials; null when it is not a URL. */
+function safeUrl(url: unknown): string | null {
+  if (typeof url !== "string") return null;
+  try {
+    const u = new URL(url);
+    return `${u.protocol}//${u.host}${u.pathname === "/" ? "" : u.pathname}${u.search}`;
+  } catch {
+    return null;
+  }
+}
+
+function priceText(price: Worker["price"]): string {
+  if (!price || typeof price !== "object") return "sem preço";
+  if (price.input === 0 && price.output === 0) return "grátis";
+  return `US$ ${price.input}/${price.output} por milhão`;
+}
+
+/** One line per alias, sorted; the token is never read. Exit 1 when any entry is malformed. */
+function list(): number {
+  const all: unknown = loadConfig().workers ?? {};
+  if (typeof all !== "object" || Array.isArray(all)) {
+    console.error(
+      "A configuração de workers em config.json é inválida: esperado um objeto de apelidos.",
+    );
+    return 1;
+  }
+  const entries = Object.entries(all as Record<string, Partial<Worker> | null>).sort(([a], [b]) =>
+    a < b ? -1 : a > b ? 1 : 0,
+  );
+  if (!entries.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const [alias, w] of entries) {
+    const url = safeUrl(w?.url);
+    if (!w || url === null || typeof w.model !== "string") {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+    } else console.log(`${alias}  ${w.model}  ${url}  ${priceText(w.price)}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
