   return r.code === 0 ? 0 : 1;
 }
 
+/** One line per alias, sorted; url without credentials, never the token. */
+function list(): number {
+  const all: unknown = loadConfig().workers;
+  if (typeof all !== "object" || all === null || Array.isArray(all)) {
+    console.error("A configuração de workers é inválida: esperado um objeto de apelidos.");
+    return 1;
+  }
+  const entries = Object.entries(all).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
+  if (!entries.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const [alias, w] of entries as [string, Partial<Worker> | null][]) {
+    if (typeof w?.url !== "string" || typeof w.model !== "string") {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    const p = w.price;
+    const price =
+      typeof p?.input !== "number" || typeof p.output !== "number"
+        ? "sem preço"
+        : p.input === 0 && p.output === 0
+          ? "grátis"
+          : `US$ ${p.input}/${p.output} por milhão`;
+    const url = w.url.replace(/^([a-z][\w+.-]*:\/\/)[^/?#]*@/i, "$1");
+    console.log(`${alias}  ${w.model}  ${url}  ${price}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
