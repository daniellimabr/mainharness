+/** Dead worker (lock with a dead PID) and no report newer than the lock: writes a failure report and warns once. */
+function reapDead(): void {
+  const { pid, sprint, task: tnn } = readLock();
+  if (typeof pid !== "number" || !sprint || !tnn || alive(pid)) return;
+  const report = path.join(dir(), `${sprint}-${tnn}.md`);
+  try {
+    if (fs.statSync(report).mtimeMs >= fs.statSync(lockFile()).mtimeMs) return;
+  } catch {
+    // no report yet
+  }
+  fs.writeFileSync(
+    report,
+    `# Trabalhador ${sprint}/${tnn}\n\nO trabalhador falhou (PID ${pid} morreu) sem gravar relatório.\n`,
+  );
+  console.error(`Trabalhador ${sprint}/${tnn} falhou sem relatório (PID ${pid} morreu): ${report}`);
+}
+
 /** Creates the lock atomically (flag wx), holding this PID until the child's; a stale lock is replaced once. */
