+  for (let taken = false; !taken;) {
+    try {
+      fs.writeFileSync(lockFile(), mine, { flag: "wx" });
+      taken = true;
+    } catch (e) {
+      if ((e as NodeJS.ErrnoException).code !== "EEXIST") throw e;
+      const lock = readLock();
+      if (alive(lock.pid)) {
+        console.error(
