+/** Dead worker with no report newer than its lock: writes a failure report and warns (once: the report is newer afterwards). */
+function reportDead(): void {
+  const { pid, sprint, task: tnn } = readLock();
+  if (typeof pid !== "number" || !sprint || !tnn || alive(pid)) return;
+  const report = path.join(dir(), `${sprint}-${tnn}.md`);
+  try {
+    if (fs.statSync(report).mtimeMs >= fs.statSync(lockFile()).mtimeMs) return;
+  } catch {
+    // no report yet
+  }
+  fs.writeFileSync(
+    report,
+    `# Trabalhador ${sprint}/${tnn}\n\nO trabalhador falhou: o processo (PID ${pid}) morreu sem gravar relatório.\n`,
+  );
+  console.error(`Trabalhador ${sprint}/${tnn} falhou sem relatório; gravei ${report}.`);
+}
+
