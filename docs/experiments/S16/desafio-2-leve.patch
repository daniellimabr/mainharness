+/** Dead worker with no newer report: writes a failure report (so the warning happens once) and warns. */
+function reportDead(): void {
+  const lock = readLock();
+  if (typeof lock.pid !== "number" || !lock.sprint || !lock.task || alive(lock.pid)) return;
+  const report = path.join(dir(), `${lock.sprint}-${lock.task}.md`);
+  try {
+    if (fs.statSync(report).mtimeMs >= fs.statSync(lockFile()).mtimeMs) return;
+  } catch {
+    // no report yet
+  }
+  fs.writeFileSync(
+    report,
+    `# Trabalhador ${lock.sprint}/${lock.task}
+
+O trabalhador falhou: o processo (PID ${lock.pid}) morreu sem gravar relatório.
+`,
+  );
+  console.error(`Trabalhador ${lock.sprint}/${lock.task} falhou sem relatório; veja ${report}.`);
+}
