@@ -193,8 +193,50 @@ async function start(args: string[], deps: Deps): Promise<number> {
   return r.code === 0 ? 0 : 1;
 }
 
+/** Aliases sorted, one line each; url without credentials, token never printed. */
+function list(): number {
+  const all: unknown = loadConfig().workers;
+  if (typeof all !== "object" || all === null || Array.isArray(all)) {
+    console.error(
+      "A configuração de workers em config.json é inválida: esperado um objeto de apelidos.",
+    );
+    return 1;
+  }
+  const names = Object.keys(all).sort();
+  if (!names.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const name of names) {
+    const w = (all as Record<string, Partial<Worker> | null>)[name];
+    let url: URL | undefined;
+    try {
+      url = typeof w?.url === "string" ? new URL(w.url) : undefined;
+    } catch {
+      url = undefined;
+    }
+    if (!w || !url || typeof w.model !== "string") {
+      console.log(`${name}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    url.username = "";
+    url.password = "";
+    const p = w.price;
+    const price = !p
+      ? "sem preço"
+      : p.input === 0 && p.output === 0
+        ? "grátis"
+        : `US$ ${p.input}/${p.output} por milhão`;
+    console.log(`${name}  ${w.model}  ${url.href.replace(/\/$/, "")}  ${price}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
