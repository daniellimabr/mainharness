+const isObj = (v: unknown): v is Record<string, unknown> =>
+  typeof v === "object" && v !== null && !Array.isArray(v);
+
+/** Aliases sorted, one line each; url without credentials, token never read. */
+function list(): number {
+  const all: unknown = loadConfig().workers;
+  if (!isObj(all)) {
+    console.error("A configuração de workers é inválida: esperava um objeto de apelidos.");
+    return 1;
+  }
+  const aliases = Object.keys(all).sort();
+  if (!aliases.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const alias of aliases) {
+    const w = all[alias];
+    if (!isObj(w) || typeof w.url !== "string" || typeof w.model !== "string") {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    const p = w.price;
+    const price =
+      isObj(p) && typeof p.input === "number" && typeof p.output === "number"
+        ? p.input === 0 && p.output === 0
+          ? "grátis"
+          : `US$ ${p.input}/${p.output} por milhão`
+        : "sem preço";
+    const url = w.url.replace(/^([a-z][a-z0-9+.-]*:\/\/)[^/?#]*@/i, "$1");
+    console.log(`${alias}  ${w.model}  ${url}  ${price}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
