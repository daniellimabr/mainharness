+/** Dead worker, no report newer than its lock: writes a failure report and warns (once: the report is then newer). */
+function reportDead(): void {
+  const { pid, sprint, task } = readLock();
+  if (typeof pid !== "number" || !sprint || !task || alive(pid)) return;
+  const report = path.join(dir(), `${sprint}-${task}.md`);
+  try {
+    const lockTime = fs.statSync(lockFile()).mtimeMs;
+    if (fs.existsSync(report) && fs.statSync(report).mtimeMs > lockTime) return;
+    fs.writeFileSync(
+      report,
+      `# Trabalhador ${sprint}/${task}\n\nO trabalhador falhou: o processo (PID ${pid}) morreu sem gravar relatório.\n`,
+    );
+    const t = new Date(Math.max(Date.now(), lockTime + 1000));
+    fs.utimesSync(report, t, t); // strictly newer than the lock even on coarse mtimes
+    console.error(`Trabalhador ${sprint}/${task} falhou: morreu sem relatório; gravei ${report}.`);
+  } catch {
+    // lock vanished meanwhile: nothing to report
+  }
+}
