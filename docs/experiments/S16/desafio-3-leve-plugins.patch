+/** One line per alias, sorted; never prints the token, strips credentials from the url. */
+function list(): number {
+  const all: unknown = loadConfig().workers;
+  if (typeof all !== "object" || all === null || Array.isArray(all)) {
+    console.error(
+      "Configuração de workers inválida em config.json: esperado um objeto de apelidos.",
+    );
+    return 1;
+  }
+  const aliases = Object.keys(all).sort((a, b) => a.localeCompare(b));
+  if (!aliases.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const alias of aliases) {
+    const w = (all as Record<string, Partial<Worker> | null>)[alias];
+    if (typeof w?.url !== "string" || typeof w.model !== "string") {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    const pr = w.price;
+    const price =
+      typeof pr?.input !== "number" || typeof pr.output !== "number"
+        ? "sem preço"
+        : pr.input === 0 && pr.output === 0
+          ? "grátis"
+          : `US$ ${pr.input}/${pr.output} por milhão`;
+    const url = w.url.replace(/^([a-z][a-z0-9+.-]*:\/\/)[^/?#]*@/i, "$1");
+    console.log(`${alias}  ${w.model}  ${url}  ${price}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
