@@ -193,8 +193,50 @@ async function start(args: string[], deps: Deps): Promise<number> {
   return r.code === 0 ? 0 : 1;
 }
 
+/** One line per alias, sorted; url without credentials, token never printed. */
+function list(): number {
+  const all: unknown = loadConfig().workers ?? {};
+  if (typeof all !== "object" || all === null || Array.isArray(all)) {
+    console.error(
+      "A configuração de workers em config.json é inválida: esperado um objeto de apelidos.",
+    );
+    return 1;
+  }
+  const entries = Object.entries(all).sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
+  if (!entries.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const [alias, w] of entries) {
+    const { url, model, price } = (w ?? {}) as Partial<Worker>;
+    let shown = "";
+    try {
+      if (typeof url === "string" && typeof model === "string") {
+        const u = new URL(url);
+        shown = `${u.protocol}//${u.host}${u.pathname === "/" ? "" : u.pathname}${u.search}`;
+      }
+    } catch {
+      /* invalid url: falls to mal configurado */
+    }
+    if (!shown) {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    const cost = !price
+      ? "sem preço"
+      : price.input === 0 && price.output === 0
+        ? "grátis"
+        : `US$ ${price.input}/${price.output} por milhão`;
+    console.log(`${alias}  ${model}  ${shown}  ${cost}`);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
