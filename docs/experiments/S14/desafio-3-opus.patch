+/** One line per alias, sorted; url without user:pass, token never printed. */
+function list(): number {
+  const all: unknown = loadConfig().workers ?? {};
+  if (!all || typeof all !== "object" || Array.isArray(all)) {
+    console.error("Configuração de workers inválida: precisa ser um objeto de apelidos.");
+    return 1;
+  }
+  const aliases = Object.keys(all).sort();
+  if (!aliases.length) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let code = 0;
+  for (const alias of aliases) {
+    const w = (all as Record<string, Partial<Worker> | null>)[alias];
+    const p = w?.price;
+    if (
+      typeof w?.url !== "string" ||
+      typeof w.model !== "string" ||
+      (p !== undefined && (typeof p?.input !== "number" || typeof p.output !== "number"))
+    ) {
+      console.log(`${alias}  (mal configurado)`);
+      code = 1;
+      continue;
+    }
+    const price = !p
+      ? "sem preço"
+      : p.input === 0 && p.output === 0
+        ? "grátis"
+        : `US$ ${p.input}/${p.output} por milhão`;
+    const line = `${alias}  ${w.model}  ${w.url.replace(/^([a-z][\w+.-]*:\/\/)[^/?#]*@/i, "$1")}  ${price}`;
+    console.log(typeof w.token === "string" && w.token ? line.split(w.token).join("***") : line);
+  }
+  return code;
+}
+
 export async function run(args: string[], deps: Deps = {}): Promise<number> {
   const [sub, ...rest] = args;
+  if (sub === "list") return list();
   if (sub === "check") return check(rest[0], deps);
   if (sub === "run") return start(rest, deps);
   console.error(USAGE);
