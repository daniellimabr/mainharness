+/** Lists worker aliases sorted, without credentials or token (for people). */
+function list(): number {
+  const all = loadConfig().workers as unknown;
+  if (all === null || typeof all !== "object" || Array.isArray(all)) {
+    console.error("Configuração de workers inválida: espera um objeto de apelidos.");
+    return 1;
+  }
+  const aliases = Object.keys(all as Record<string, unknown>).sort();
+  if (aliases.length === 0) {
+    console.log("Nenhum trabalhador configurado.");
+    return 0;
+  }
+  let bad = false;
+  for (const alias of aliases) {
+    const w = (all as Record<string, unknown>)[alias];
+    if (w === null || typeof w !== "object") {
+      console.log(`${alias}  (mal configurado)`);
+      bad = true;
+      continue;
+    }
+    const rec = w as { url?: unknown; model?: unknown; price?: unknown };
+    if (typeof rec.url !== "string" || typeof rec.model !== "string") {
+      console.log(`${alias}  (mal configurado)`);
+      bad = true;
+      continue;
+    }
+    const url = rec.url.replace(/^([a-z][a-z0-9+.-]*:\/\/)[^/@]*@/i, "$1");
+    console.log(`${alias}  ${rec.model}  ${url}  ${priceLabel(rec.price)}`);
+  }
+  return bad ? 1 : 0;
+}
+
+/** "sem preço", "grátis" or "US$ <input>/<output> por milhão". */
+function priceLabel(price: unknown): string {
+  if (price === null || typeof price !== "object") return "sem preço";
+  const p = price as { input?: unknown; output?: unknown };
+  if (p.input === 0 && p.output === 0) return "grátis";
+  return `US$ ${p.input}/${p.output} por milhão`;
+}
