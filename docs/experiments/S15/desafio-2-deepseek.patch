+/** A dead worker with no report newer than its lock: writes a failure report and warns (once). */
+function reportDeadWorker(): void {
+  const lock = readLock();
+  if (typeof lock.pid !== "number" || !lock.sprint || !lock.task || alive(lock.pid)) return;
+  let lockMtime: number;
+  try {
+    lockMtime = fs.statSync(lockFile()).mtimeMs;
+  } catch {
+    return;
+  }
+  const report = path.join(dir(), `${lock.sprint}-${lock.task}.md`);
+  if (fs.existsSync(report) && fs.statSync(report).mtimeMs >= lockMtime) return;
+  fs.writeFileSync(
+    report,
+    `# Trabalhador ${lock.sprint}/${lock.task}\n\nO trabalhador falhou sem gravar relatório.\n`,
+  );
+  console.error(`Trabalhador ${lock.sprint}/${lock.task} falhou sem relatório.`);
+}
+
