+/** Creates the lock atomically (owner: this process). Returns null on success, else the live holder's lock. */
+function acquireLock(sprint: string, task: string): ReturnType<typeof readLock> | null {
+  fs.mkdirSync(dir(), { recursive: true });
+  const body = JSON.stringify({ pid: process.pid, sprint, task });
+  for (let i = 0; i < 2; i++) {
+    try {
+      fs.writeFileSync(lockFile(), body, { flag: "wx" });
+      return null;
+    } catch (e) {
+      if ((e as NodeJS.ErrnoException).code !== "EEXIST") throw e;
+    }
+    const lock = readLock();
+    if (alive(lock.pid)) return lock;
+    fs.rmSync(lockFile(), { force: true }); // dead, empty or invalid: stale
+  }
+  return readLock();
+}
